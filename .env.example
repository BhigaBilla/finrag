# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=finrag
# Optional: any init_chat_model id, and the request rate cap (per minute)
LLM_MODEL=google_genai:gemini-3.8-flash
LLM_RPM=8
# Optional: free Groq key (console.groq.com), used only as the answer-eval judge
GROQ_API_KEY=
